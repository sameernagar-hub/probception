# Copy to .env and fill in. NEVER commit .env — it is gitignored.
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS / Linux:      cp .env.example .env

# --- Anthropic (Claude) --------------------------------------------------
# Console account: https://platform.claude.com
# re:AGENT offer:  https://platform.claude.com/offers/06628132-91eb-4a12-abe4-47c70481280d
ANTHROPIC_API_KEY=

# Model + effort. Opus 5 is the default; drop to sonnet for cheap bulk passes.
PROBCEPTION_MODEL=claude-opus-5
PROBCEPTION_EFFORT=high

# --- GXL Paperclip (literature / datasets / trials) ----------------------
# Account: https://paperclip.gxl.ai/login
# Redeem:  https://paperclip.gxl.ai/redeem?code=HACKATHON2026
PAPERCLIP_API_KEY=
PAPERCLIP_BASE_URL=https://api.paperclip.gxl.ai

# --- Proto (generative biology design) -----------------------------------
PROTO_API_KEY=
PROTO_BASE_URL=

# --- Modal (compute for Proto, ESM, Boltz) -------------------------------
# Credits: https://modal.fillout.com/t/qMXCmRGseUus  then: pip install modal && modal setup
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Tamarind (100 hosted jobs) ------------------------------------------
# Redeem: https://app.tamarind.bio/code/gxl-hackathon-26
TAMARIND_API_KEY=

# --- Benchling (LIMS + MCP server) ---------------------------------------
# Login: https://hackathon.bnchdev.org
BENCHLING_API_KEY=
BENCHLING_TENANT=

# --- Phylo / Biomni (Pro plan, coupon RE-AGENT-2026) ---------------------
PHYLO_API_KEY=

# --- Runtime behaviour ---------------------------------------------------
# "mock" runs the entire loop with zero credentials (use this first).
# "live" hits the real adapters above.
PROBCEPTION_MODE=mock
PROBCEPTION_RUN_DIR=runs
PROBCEPTION_SEED=1729
